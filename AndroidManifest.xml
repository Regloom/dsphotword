<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.regloom.dsphotword"
    android:versionCode="14"
    android:versionName="1.9.1">

    <uses-sdk
        android:minSdkVersion="34"
        android:targetSdkVersion="37" />

    <!-- SoundTrigger middleware checks these for the originator identity. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAPTURE_AUDIO_HOTWORD" />
    <uses-permission android:name="android.permission.MANAGE_SOUND_TRIGGER" />
    <uses-permission android:name="android.permission.SOUND_TRIGGER_RUN_IN_BATTERY_SAVER" />
    <!-- Read the enrolled keyphrase model without being the voice interaction service. -->
    <uses-permission android:name="android.permission.KEYPHRASE_ENROLLMENT_APPLICATION" />
    <!-- Required by the enrollment app to accept our enroll broadcast. -->
    <uses-permission android:name="android.permission.MANAGE_VOICE_KEYPHRASES" />
    <!-- Launch the assistant from the background after the hotword. -->
    <uses-permission android:name="android.permission.START_ACTIVITIES_FROM_BACKGROUND" />
    <!-- signature: show the session of an assistant that has its own voice service. -->
    <uses-permission android:name="android.permission.ACCESS_VOICE_INTERACTION_SERVICE" />
    <!-- signature: read the ASSISTANT role holder. -->
    <uses-permission android:name="android.permission.MANAGE_ROLE_HOLDERS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <queries>
        <intent>
            <action android:name="android.intent.action.ASSIST" />
        </intent>
        <package android:name="com.android.hotwordenrollment.xgoogle" />
    </queries>

    <application
        android:name=".TriggerApplication"
        android:label="@string/app_name"
        android:icon="@android:drawable/ic_btn_speak_now"
        android:persistent="true"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.DayNight">

        <!-- Wakes the screen and dismisses the keyguard before starting the assistant. -->
        <activity
            android:name=".UnlockTrampolineActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:exported="false" />

        <!-- Settings screen, injected into Settings → System (no launcher icon). -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:icon="@drawable/ic_hotword"
            android:label="@string/settings_title"
            android:theme="@android:style/Theme.DeviceDefault.Settings">
            <intent-filter>
                <action android:name="com.android.settings.action.EXTRA_SETTINGS" />
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.system" />
            <!-- With KernelSU "umount modules" the Settings process can't open this APK (it
                 lives in a module), so it can't load our resources. The title and summary come
                 from SettingsTileProvider, which runs in our process (localized, live summary);
                 the literal values are only a fallback. -->
            <meta-data
                android:name="com.android.settings.title"
                android:value="“OK Google” voice activation" />
            <meta-data
                android:name="com.android.settings.title_uri"
                android:value="content://io.github.regloom.dsphotword.settings/getTitle" />
            <meta-data
                android:name="com.android.settings.summary"
                android:value="Start the assistant with “OK Google”" />
            <meta-data
                android:name="com.android.settings.summary_uri"
                android:value="content://io.github.regloom.dsphotword.settings/getSummary" />
            <!-- Shown only if Settings can see the APK (umount off for Settings). -->
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_hotword" />
        </activity>

        <!-- Localized title and live summary for the Settings entry. -->
        <provider
            android:name=".SettingsTileProvider"
            android:authorities="io.github.regloom.dsphotword.settings"
            android:exported="true" />

        <!-- Quick-settings tile to toggle listening. -->
        <service
            android:name=".ToggleTileService"
            android:exported="true"
            android:icon="@drawable/ic_hotword"
            android:label="OK Google"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>
</manifest>
