<?xml version="1.0" encoding="utf-8"?>
<!-- SoundTrigger middleware checks RECORD_AUDIO for the originator identity; system apps don't get
     runtime permissions automatically, so grant it by default. -->
<exceptions>
    <exception package="io.github.regloom.dsphotword">
        <permission name="android.permission.RECORD_AUDIO" fixed="false" />
    </exception>
</exceptions>
